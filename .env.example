# Copy to .env and fill from Supabase → Settings → API.
# Vite bakes these in at BUILD time. Changing them on the host without rebuild does nothing.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT

# Either name works. Lovable/Vite uses PUBLISHABLE_KEY; AWS/Railway docs often say ANON_KEY.
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: show one-tap tester logins on the hosted site (dev always shows them).
# VITE_ENABLE_DEMO_LOGINS=true
